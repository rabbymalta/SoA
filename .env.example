# Copy to .env before `docker compose up`. Nothing here is a production secret: in
# AWS every one of these is either a Lambda environment variable set by the CDK
# stack or a reference to Secrets Manager, and the access keys do not exist at all
# because the functions use their execution role.

# --- runtime -----------------------------------------------------------------
ENVIRONMENT=local                     # local | staging | production
LOG_LEVEL=info                        # debug | info | warn | error
SERVICE_VERSION=1.2.0

# --- the cloud, locally ------------------------------------------------------
AWS_ENDPOINT_URL=http://localstack:4566   # unset in AWS, which is the whole point
AWS_REGION=eu-south-1
AWS_ACCESS_KEY_ID=test                    # LocalStack ignores these
AWS_SECRET_ACCESS_KEY=test

# --- platform ----------------------------------------------------------------
EVENT_BUS=maltashop-bus
WORKFLOW_URL=http://workflow-service:8084

# --- behaviour ---------------------------------------------------------------
CARD_CEILING_EUR=600                  # the stubbed provider declines above this
